# FloorGuard keeper configuration. Copy to .env (never commit it) or export these in the environment.
# Everything except the two required lines shows its default.

# ---- required ---------------------------------------------------------------------------------------
KEEPER_RPC_URL=http://127.0.0.1:8547
KEEPER_CHAIN_ID=31337

# ---- the key ----------------------------------------------------------------------------------------
# With neither set the keeper runs in dry-run mode and says so. Use a fresh key that owns nothing and
# holds only gas money. Never put a key in a file that is committed.
#KEEPER_PRIVATE_KEY=
# ...or an encrypted keystore (Web3 Secret Storage v3, e.g. from `cast wallet import`), with its password
# in the environment or in a file readable only by the keeper's user:
#KEEPER_KEYSTORE=/etc/floorguard/keeper.keystore.json
#KEEPER_KEYSTORE_PASSWORD=
#KEEPER_KEYSTORE_PASSWORD_FILE=/etc/floorguard/keeper.password
# Simulate and report, send nothing (also: --dry-run)
#KEEPER_DRY_RUN=false
# `from` of the simulations when there is no key
#KEEPER_SIMULATE_FROM=0x000000000000000000000000000000000000dEaD

# ---- where things are -------------------------------------------------------------------------------
# Addresses written by script/Deploy.s.sol, and Foundry's build output for the ABIs
#KEEPER_DEPLOYMENT_FILE=../deployments/<chain id>.json
#KEEPER_OUT_DIR=../out
# Optional. Remembers the last scanned block, the day's spend and the last points flush between runs.
# Without it every run scans logs from KEEPER_START_BLOCK and the daily budget only holds within one process.
#KEEPER_CACHE_FILE=.keeper-cache.json
# Optional JSON file with any of these keys (not the secrets). The environment wins.
#KEEPER_CONFIG=keeper.json
# The block the protocol was deployed in. The deployment file does not record it. Log scans start here.
#KEEPER_START_BLOCK=0
# Largest block span of one eth_getLogs request; halved automatically when the provider refuses.
#KEEPER_LOG_RANGE=5000
#KEEPER_READ_CONCURRENCY=25

# ---- tasks: each has its own switch -----------------------------------------------------------------
#KEEPER_TASK_PREDICTION=true
#KEEPER_TASK_POINTS=true
#KEEPER_TASK_VAULT_RAFFLE=true
#KEEPER_TASK_LOTTERY=true
#KEEPER_TASK_TICKET_RAFFLE=true
#KEEPER_TASK_GAMES=true
#KEEPER_TASK_VAULT=true
#KEEPER_TASK_MONITOR=true

# ---- spending limits --------------------------------------------------------------------------------
# No transaction is sent while base fee + tip is above this, and no fee bump goes past it.
#KEEPER_MAX_FEE_GWEI=30
#KEEPER_MAX_PRIORITY_FEE_GWEI=2
# Worst-case cost (gas limit x fee cap) of every transaction is checked against both before it is sent.
#KEEPER_MAX_SPEND_PER_RUN_ETH=0.05
#KEEPER_MAX_SPEND_PER_DAY_ETH=0.2
#KEEPER_MAX_GAS_PER_TX=3000000
# Added to the gas estimate, in basis points
#KEEPER_GAS_LIMIT_MARGIN_BPS=3000
#KEEPER_MAX_ACTIONS_PER_RUN=50
# How long to wait for a transaction before replacing it with 12.5% more, and how often to do that
#KEEPER_TX_TIMEOUT_SECONDS=90
#KEEPER_MAX_REPLACEMENTS=3
# Monitoring warns when the keeper holds less than this
#KEEPER_LOW_BALANCE_ETH=0.02

# ---- watch mode -------------------------------------------------------------------------------------
#KEEPER_POLL_SECONDS=60
# Used while something is overdue, e.g. a market waiting for its settlement price
#KEEPER_FAST_POLL_SECONDS=6

# ---- prediction markets -----------------------------------------------------------------------------
# A market waiting this long for a price is reported as a warning instead of a note
#KEEPER_PREDICTION_STUCK_WARN_SECONDS=3600

# ---- points -----------------------------------------------------------------------------------------
# Scheduled activation of pending points, and again this long before a raffle can be drawn
#KEEPER_FLUSH_INTERVAL_SECONDS=86400
#KEEPER_FLUSH_LEAD_SECONDS=3600
# Batches are sized from this gas figure per account and split in two if the estimate is still too high
#KEEPER_FLUSH_MAX_BATCH=100
#KEEPER_FLUSH_GAS_PER_ACCOUNT=110000
# Ignore pending balances below this many points (18 decimals at the default rate). Raise it if someone
# farms dust credits to make the keeper pay for their activation.
#KEEPER_FLUSH_MIN_PENDING=1
# Skip the scheduled flush while no raffle is open. Not safe if announcePeriod can be shorter than the interval.
#KEEPER_FLUSH_ONLY_WITH_OPEN_RAFFLE=false
# Do not draw a vault raffle while known accounts still have pending points
#KEEPER_REQUIRE_FLUSHED_BEFORE_DRAW=true

# ---- opt-in actions: all off by default -------------------------------------------------------------
# Turn rounds and raffles that are stuck past their abort time into refunds. Off: they are reported.
#KEEPER_LOTTERY_ABORT=false
#KEEPER_TICKET_RAFFLE_ABORT=false
# Never request a draw this close to the abort time: mined after it, draw/close opens refunds instead.
#KEEPER_ABORT_GUARD_SECONDS=900
# Start the Dutch auction of a holding left unlocked past the 30-day governance window
#KEEPER_VAULT_START_AUCTION=false
# Restart an oracle-priced auction that has sat at its reserve for the dwell time without a buyer
#KEEPER_VAULT_RESTART_AUCTION=false
# (never shorter than the Vault's own AUCTION_RESTART_DWELL, one day)
#KEEPER_VAULT_RESTART_DWELL_SECONDS=259200

# ---- monitoring -------------------------------------------------------------------------------------
# Collections to report on, and whose floor the vault task samples daily, in addition to those found
# from the engine's BidConfigured events (and, for sampling, those the Vault holds)
#KEEPER_COLLECTIONS=
# Default: "owner" in the deployment file
#KEEPER_EXPECTED_OWNER=
# Default: the randomness addresses in the deployment file
#KEEPER_EXPECTED_RANDOMNESS_VAULT=
#KEEPER_EXPECTED_RANDOMNESS_VAULT_RAFFLE=
#KEEPER_EXPECTED_RANDOMNESS_GAMES=
#KEEPER_EXPECTED_RANDOMNESS_TICKET_RAFFLE=
#KEEPER_EXPECTED_RANDOMNESS_LOTTERY=
# Warn when a draw or bet has waited this long for randomness
#KEEPER_VRF_WARN_SECONDS=600
# Warn when a budget is more than this many bids deep (the economics review says 3)
#KEEPER_BUDGET_IN_BIDS_WARN=3

# ---- output -----------------------------------------------------------------------------------------
# json: JSON lines on stdout. text: the summary on stdout. both: JSON lines on stdout, summary on stderr.
#KEEPER_LOG_FORMAT=both
